# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# New projects show a "publishable" key (sb_publishable_...). Older projects: paste the anon key here instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used for auth email redirects. Local: http://localhost:3000  Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Demo mode (default: on). Visitors are signed in as the shared guest agent (guest@example.com) and can
# switch between the seeded demo agents without logging in. Set to false to require real logins.
NEXT_PUBLIC_DEMO_MODE=true
# Password shared by the demo agents created by scripts/seed-demo.mjs (server-side only).
DEMO_AGENT_PASSWORD=Demo123456
