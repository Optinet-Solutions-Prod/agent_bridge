# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# New projects show a "publishable" key (sb_publishable_...). Older projects: paste the anon key here instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used for auth email redirects. Local: http://localhost:3000  Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
